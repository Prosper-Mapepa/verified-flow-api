# Railway Postgres — use the variable reference in Railway UI:
# DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://user:pass@host:5432/railway

SEAL_SECRET=change-me-long-secret
SESSION_SECRET=change-me-another-long-secret
PORT=4000
CORS_ORIGIN=https://your-site.netlify.app,http://localhost:3000
NODE_ENV=production
